{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "postinstall": "node scripts/patch-expo-bin.cjs",
    "start": "bash scripts/expo-start.sh",
    "start:lan": "expo start --lan",
    "start:clear": "bash scripts/expo-start.sh -c",
    "start:android": "bash scripts/open-android-expo-go.sh",
    "reset:android": "adb shell pm clear host.exp.exponent",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run lint && npx expo export --platform web --output-dir /tmp/alladin-mobile-bundle-test",
    "build:preview:android": "npx eas-cli@latest build --platform android --profile preview",
    "build:preview:ios": "npx eas-cli@latest build --platform ios --profile preview",
    "build:android": "npx eas-cli@latest build --platform android --profile production",
    "build:ios": "npx eas-cli@latest build --platform ios --profile production",
    "build:all": "npx eas-cli@latest build --platform all --profile production",
    "submit:android": "npx eas-cli@latest submit --platform android --profile production --latest",
    "submit:android:internal": "npx eas-cli@latest submit --platform android --profile internal --latest",
    "submit:ios": "npx eas-cli@latest submit --platform ios --profile production --latest",
    "submit:all": "npx eas-cli@latest submit --platform all --profile production --latest",
    "release:android": "npm run build:android && npm run submit:android",
    "release:ios": "npm run build:ios && npm run submit:ios"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.15.11",
    "@react-navigation/elements": "^2.9.18",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.12",
    "axios": "^1.16.0",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.35",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "zustand": "^5.0.13"
  },
  "private": true,
  "devDependencies": {
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-import-resolver-babel-module": "^5.3.2",
    "playwright": "^1.60.0"
  }
}
